# Secret used to sign access tokens and derive the OpenAI safety identifier.
# Use a long random value and never commit your real production secret.
MEDIVOX_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional legacy development gate for test clients.
MEDIVOX_DEV_TOKEN=replace-with-a-long-random-development-token

# OpenAI Realtime configuration.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
